#!/usr/bin/env bash
# Keeps the article count in index.html and articles.html honest. Enabled via:
#   git config core.hooksPath githooks
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
"$repo_root/scripts/update-article-count.sh"

for f in index.html articles.html; do
    if ! git diff --quiet -- "$repo_root/$f"; then
        git add "$repo_root/$f"
        echo "pre-commit: $f article count updated and staged"
    fi
done
